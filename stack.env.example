# Variáveis da stack do Terra.Ce para o Portainer.
# Copie para um arquivo fora do repositório, preencha e carregue em
# Stacks → Add stack → Environment variables → Load variables from .env file.
# Sem aspas em nenhum valor. Nunca faça commit do arquivo preenchido.

# ---- Obrigatórias ----
# Versão do PostGIS em uso hoje: veja PG_MAJOR e POSTGIS_VERSION nas variáveis
# do container terra_postgis (ex.: PG_MAJOR=17 e POSTGIS_VERSION=3.5.x → 17-3.5).
POSTGIS_TAG=
# Nome exato do volume atual do Postgres, como aparece em Volumes no Portainer.
POSTGRES_VOLUME=
# Senha atual do Postgres (copie das variáveis do container terra_postgis).
POSTGRES_PASSWORD=
# Segredo JWT compartilhado por miniserver, dashboard e Terra-AI (copie do terra_geodata_mini_server).
JWT_SECRET=

# ---- Recomendadas ----
# Chave dos basemaps da CARTO (copie do container dashboard_fundiario_ce).
CARTO_API_KEY=

# ---- Opcionais: descomente só se o valor atual for diferente do padrão ----
# TGDM_TAG=1.2.0
# DFUNDCE_TAG=1.2.0
# POSTGRES_USER=terra
# POSTGRES_DB=geodata
# TABLE_GEOM_MUNICIPIOS=municipios_ceara
# TABLE_DADOS_FUNDIARIOS=malha_fundiaria_ceara
# TABLE_DADOS_ASSENTAMENTOS=assentamentos_ceara
# TABLE_DADOS_RESERVATORIOS=reservatorios_ceara
# TABLE_TEMPORARY=temp_table
# TABLE_RA_MUNICIPIOS_MF_CE=regioes_administrativas_municipios_malha_fundiaria_ceara
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
# GEOMETRY_TOLERANCE=0.001
# GEOMETRY_DECIMALS=6
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
